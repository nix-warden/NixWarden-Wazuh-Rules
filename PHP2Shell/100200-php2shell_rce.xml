<!-- 
  NixWarden - Wazuh Ruleset
  Category: Web Application Security / CVE & Exploit Detections
  Vulnerability: PHP2Shell (CVE-2026-109618, CVE-2026-109619)
  
  MITRE ATT&CK: 
    - T1595.002 (Active Scanning: Vulnerability Scanning)
    - T1190 (Exploit Public-Facing Application)
    - T1499.003 (Endpoint Denial of Service: OS Exhaustion Flood)
    - T1505.003 (Server Software Component: Web Shell)
    - T1071.001 (Application Layer Protocol: Web Protocols)
    - T1105 (Ingress Tool Transfer: curl/wget)
    - T1571 (Non-Standard Port: Reverse Shells)
    - T1059.004 (Command and Scripting Interpreter: Unix Shell)
  
  Cyber Kill Chain:
    - kill_chain_delivery (malicious multipart payload transmission / crash)
    - kill_chain_reconnaissance (repeated memory probing / parameter tuning)
    - kill_chain_exploitation (heap exhaustion & active RCE trigger)
    - kill_chain_installation (webshell drop & persistence in web root)
    - kill_chain_c2 (outbound reverse shell or HTTP 200 web shell interaction)
    - kill_chain_actions_on_objectives (post-exploitation commands via auditd)

  Description:
  Hardened, multi-vector enterprise detection ruleset for PHP2Shell vulnerabilities.
  Strictly adheres to Lockheed Martin Cyber Kill Chain progression:
  1. Delivery (L5): Single PHP memory / timeout crashes or HTTP 500/502/503/504 on PHP endpoints.
  2. Reconnaissance (L8): Aggregated delivery anomalies from the same source IP.
  3. Exploitation (L12): High-frequency memory exhaustion confirming heap grooming.
  4. Installation (L10 -> L14): Web shell drops, escalating to Level 14 if preceded by exploitation.
  5. Command and Control (L11-L12 -> L14): Outbound reverse shells (Auditd) or HTTP 200 web shell calls (Access Log).
  6. Actions on Objectives (L10 -> L14): Shell command execution, escalating to Level 14 if preceded by exploit/install/c2.

  Reference & Attribution:
  Based on foundational research and baseline logic published by Wazuh:
  https://wazuh.com/blog/detecting-php2shell-remote-code-execution-with-wazuh/
-->
<group name="php2shell,web,appsec,attack,">

  <!-- =================================================================== -->
  <!-- Phase 1: Kill Chain - Delivery (Web Error & Access Logs)             -->
  <!-- =================================================================== -->

  <!-- Delivery: Single PHP Memory Exhaustion Fatal Error (Triage Level) -->
  <rule id="100200" level="5">
    <if_sid>31420</if_sid>
    <match>Allowed memory size of </match>
    <regex type="pcre2">Allowed memory size of \d+ bytes exhausted</regex>
    <description>PHP2Shell delivery: PHP memory exhaustion fatal error</description>
    <mitre>
      <id>T1190</id>
      <id>T1499.003</id>
    </mitre>
    <group>kill_chain_delivery,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_SC.5,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.6,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- Delivery: PHP Maximum Execution Time Exceeded (Triage Level) -->
  <rule id="100201" level="5">
    <if_sid>31420</if_sid>
    <match>Maximum execution time of </match>
    <regex type="pcre2">Maximum execution time of \d+ seconds? exceeded</regex>
    <description>PHP2Shell delivery: PHP maximum execution time exceeded</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>kill_chain_delivery,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.6,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- Delivery: Web Server FastCGI Backend Death or Timeout (502/504) -->
  <rule id="100205" level="5">
    <if_sid>31120</if_sid>
    <id>^502$|^504$</id>
    <description>PHP2Shell delivery: Web server FastCGI backend death or timeout (502/504)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>system_error,kill_chain_delivery,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_SI.4,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- Delivery: Web Server 500/503 Crash on PHP or API Upload Route -->
  <rule id="100214" level="5">
    <if_sid>31120</if_sid>
    <id>^500$|^503$</id>
    <url type="pcre2">(?:\.(?:php[0-9]?|phtml)\b|/(?:api|wp-json|graphql|rest|upload|media)/)\b</url>
    <description>PHP2Shell delivery: Web server 500/503 crash on PHP or API upload endpoint</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>system_error,kill_chain_delivery,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_SI.4,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- =================================================================== -->
  <!-- Phase 2: Kill Chain - Reconnaissance & Probing Escalation           -->
  <!-- =================================================================== -->

  <!-- Probing: Repeated Delivery Anomalies (3 events in 60s from same IP) -->
  <rule id="100204" level="8" frequency="3" timeframe="60">
    <if_matched_group>kill_chain_delivery</if_matched_group>
    <same_source_ip />
    <description>PHP2Shell probing: Repeated delivery anomalies from same IP</description>
    <mitre>
      <id>T1595.002</id>
      <id>T1190</id>
    </mitre>
    <group>kill_chain_reconnaissance,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.6,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- =================================================================== -->
  <!-- Phase 3: Kill Chain - Exploitation (Active Memory Corruption)       -->
  <!-- =================================================================== -->

  <!-- Exploitation: High-Frequency Memory Exhaustion (5 events in 120s) -->
  <rule id="100202" level="12" frequency="5" timeframe="120">
    <if_matched_sid>100200</if_matched_sid>
    <same_source_ip />
    <description>PHP2Shell: High-frequency PHP memory exhaustion. Active RCE exploitation attempt</description>
    <mitre>
      <id>T1190</id>
      <id>T1499.003</id>
    </mitre>
    <group>kill_chain_exploitation,pci_dss_6.5.2,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_32.2,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_SC.5,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.6,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- Exploitation: PHP-FPM Pool Worker Crash (Signal 11 SIGSEGV or Signal 6 SIGABRT) -->
  <rule id="100213" level="10">
    <if_sid>1</if_sid>
    <match>exited on signal 11|exited on signal 6</match>
    <regex type="pcre2">\[pool \S+\] child \d+ exited on signal (?:11 \(SIGSEGV\)|6 \(SIGABRT\))</regex>
    <description>PHP2Shell exploitation: PHP-FPM worker crash (CVE-2026-109619 memory corruption)</description>
    <mitre>
      <id>T1190</id>
      <id>T1499.003</id>
    </mitre>
    <group>kill_chain_exploitation,pci_dss_6.5.2,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_32.2,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_SC.5,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.6,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- Exploitation: Linux Kernel Segfault of PHP / PHP-FPM Worker (Child of Stock Rule 1010) -->
  <rule id="100215" level="10">
    <if_sid>1010</if_sid>
    <match>php</match>
    <regex type="pcre2">\bphp(?:-fpm)?(?:[0-9.]*)?(?:\[\d+\])?: segfault at</regex>
    <description>PHP2Shell exploitation: Linux kernel segfault in PHP process (CVE-2026-109619 memory corruption)</description>
    <mitre>
      <id>T1190</id>
      <id>T1499.003</id>
    </mitre>
    <group>kill_chain_exploitation,pci_dss_6.5.2,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_32.2,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_SC.5,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.6,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- =================================================================== -->
  <!-- Phase 4: Kill Chain - Installation (FIM / Syscheck)                 -->
  <!-- Note: Placed above Phase 5 & 6 so analysisd links history groups.   -->
  <!-- =================================================================== -->

  <!-- Standalone: New Executable Script Dropped or Modified in Web Root -->
  <rule id="100206" level="10">
    <if_sid>554, 550</if_sid>
    <field name="file" type="pcre2">/(?:var/www|usr/share/nginx/html|srv/www|srv/http|tmp|dev/shm)/.*?\.(?:php[0-9]?|phtml|phar|so|inc)$</field>
    <description>PHP2Shell post-exploitation: Suspicious executable script created or modified in web directory</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
    <group>syscheck,post_exploitation,webshell,kill_chain_installation,pci_dss_11.5,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_32.2,gdpr_IV_35.7.d,hipaa_164.312.c.1,nist_800_53_SI.4,nist_800_53_SI.7,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- Chained Escalation: Web shell created/modified following exploitation -->
  <rule id="100207" level="14">
    <if_sid>100206</if_sid>
    <if_matched_group>kill_chain_exploitation</if_matched_group>
    <description>PHP2Shell confirmed compromise: Web shell created or modified following exploitation attempts</description>
    <mitre>
      <id>T1505.003</id>
      <id>T1190</id>
    </mitre>
    <group>syscheck,post_exploitation,webshell,kill_chain_installation,pci_dss_11.5,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_32.2,gdpr_IV_35.7.d,hipaa_164.312.c.1,nist_800_53_SI.4,nist_800_53_SI.7,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- =================================================================== -->
  <!-- Phase 5: Kill Chain - Command and Control (C2: Host & Web Access)   -->
  <!-- Note: Placed above Phase 6 so analysisd links group kill_chain_c2.  -->
  <!-- =================================================================== -->

  <!-- Standalone: Outbound Network/C2 Utility Spawned by Web Server User -->
  <rule id="100209" level="12">
    <if_sid>80792</if_sid>
    <field name="audit.euid" type="pcre2">^(?:33|48|82|www-data|apache|nginx|nobody)$</field>
    <field name="audit.exe" type="pcre2">/(?:nc|netcat|ncat|socat|curl|wget|telnet|chisel)$</field>
    <description>PHP2Shell C2: Network communication or reverse shell tool spawned by web server user</description>
    <mitre>
      <id>T1071</id>
      <id>T1105</id>
      <id>T1571</id>
    </mitre>
    <group>audit,post_exploitation,c2,kill_chain_c2,pci_dss_10.2.2,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_32.2,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AC.7,nist_800_53_AU.14,nist_800_53_SC.7,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.6,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- Chained Escalation: C2 tool spawned following exploitation or installation -->
  <rule id="100210" level="14">
    <if_sid>100209</if_sid>
    <if_matched_group>kill_chain_exploitation,kill_chain_installation</if_matched_group>
    <description>PHP2Shell confirmed C2: Reverse shell or network utility spawned following exploitation or webshell drop</description>
    <mitre>
      <id>T1071</id>
      <id>T1105</id>
      <id>T1190</id>
      <id>T1571</id>
    </mitre>
    <group>audit,post_exploitation,c2,kill_chain_c2,pci_dss_10.2.2,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_32.2,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AC.7,nist_800_53_AU.14,nist_800_53_SC.7,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.6,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- Standalone: Direct HTTP 200 Execution of PHP Script in Upload/Static Directory -->
  <rule id="100211" level="11">
    <if_sid>31100, 31108</if_sid>
    <id>^200$</id>
    <url type="pcre2">/(?:uploads?|wp-content/uploads|images?|media|tmp|cache)/.*?\.(?:php|phtml|phar)\b</url>
    <description>PHP2Shell C2: Direct HTTP 200 execution of script in upload or static directory</description>
    <mitre>
      <id>T1505.003</id>
      <id>T1071.001</id>
      <id>T1190</id>
    </mitre>
    <group>web,accesslog,c2,webshell,kill_chain_c2,pci_dss_6.5,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_32.2,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AC.7,nist_800_53_AU.14,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.6,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- Chained Escalation: HTTP 200 web shell interaction following exploitation or drop -->
  <rule id="100212" level="14">
    <if_sid>100211</if_sid>
    <if_matched_group>kill_chain_exploitation,kill_chain_installation</if_matched_group>
    <description>PHP2Shell confirmed C2: HTTP 200 interaction with web shell following exploitation or file drop</description>
    <mitre>
      <id>T1505.003</id>
      <id>T1071.001</id>
      <id>T1190</id>
    </mitre>
    <group>web,accesslog,c2,webshell,kill_chain_c2,pci_dss_6.5,pci_dss_10.2.2,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_32.2,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AC.7,nist_800_53_AU.14,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.6,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- =================================================================== -->
  <!-- Phase 6: Kill Chain - Actions on Objectives (Auditd Execution)      -->
  <!-- =================================================================== -->

  <!-- Standalone: Command/Shell Spawned by Web Server Service User -->
  <rule id="100203" level="10">
    <if_sid>80792</if_sid>
    <field name="audit.euid" type="pcre2">^(?:33|48|82|www-data|apache|nginx|nobody)$</field>
    <description>PHP2Shell post-exploitation: Shell command executed by web server user</description>
    <mitre>
      <id>T1059.004</id>
    </mitre>
    <group>audit,post_exploitation,rce,kill_chain_actions_on_objectives,pci_dss_10.2.2,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_32.2,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- Chained Escalation: Command execution following exploitation, installation, or C2 -->
  <rule id="100208" level="14">
    <if_sid>100203</if_sid>
    <if_matched_group>kill_chain_exploitation,kill_chain_installation,kill_chain_c2</if_matched_group>
    <description>PHP2Shell confirmed compromise: Shell command spawned by web server user following exploit, webshell drop, or C2 channel</description>
    <mitre>
      <id>T1059.004</id>
      <id>T1190</id>
    </mitre>
    <group>audit,post_exploitation,rce,kill_chain_actions_on_objectives,pci_dss_10.2.2,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_32.2,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

</group>

<!-- 
  NixWarden - Wazuh Ruleset
  Category: Web Application Security / CVE & Exploit Detections
  Vulnerability: PHP2Shell (CVE-2026-109618, CVE-2026-109619)
  
  MITRE ATT&CK: 
    - T1595.002 (Active Scanning: Vulnerability Scanning)
    - T1190 (Exploit Public-Facing Application)
    - T1499.003 (Endpoint Denial of Service: OS Exhaustion Flood)
    - T1059.004 (Command and Scripting Interpreter: Unix Shell)
    - T1505.003 (Server Software Component: Web Shell)
  
  Cyber Kill Chain:
    - kill_chain_reconnaissance (active probing)
    - kill_chain_delivery (malicious multipart payloads)
    - kill_chain_exploitation (OOM memory corruption via longjmp)
    - kill_chain_installation (webshell persistence in web root)
    - kill_chain_actions_on_objectives (post-exploitation commands via auditd)

  Description:
  Hardened, multi-vector enterprise detection ruleset for PHP2Shell vulnerabilities.
  Combines native rule inheritance (31420, 31122, 80792, 554/550), specific SID tracking, 
  and functional group aggregation (php2shell_precursor, php2shell_exploit) for 
  high-fidelity staged attack correlation and chained compromise escalation (Level 14).

  Reference & Attribution:
  Based on foundational research and baseline logic published by Wazuh:
  https://wazuh.com/blog/detecting-php2shell-remote-code-execution-with-wazuh/
-->
<group name="php2shell,web,appsec,attack,">

  <!-- =================================================================== -->
  <!-- Vector 1: Web Error Logs - Exploit Precursors & Probing (0265-php)   -->
  <!-- =================================================================== -->

  <!-- Precursor: Single PHP Memory Exhaustion Fatal Error (Triage Level) -->
  <rule id="100200" level="5">
    <if_sid>31420</if_sid>
    <match>Allowed memory size of </match>
    <regex type="pcre2">Allowed memory size of \d+ bytes exhausted</regex>
    <description>PHP2Shell precursor: PHP memory exhaustion fatal error</description>
    <mitre>
      <id>T1190</id>
      <id>T1499.003</id>
    </mitre>
    <group>php2shell_precursor,kill_chain_delivery,kill_chain_exploitation,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_SC.5,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.6,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- Precursor: PHP Maximum Execution Time Exceeded (Triage Level) -->
  <rule id="100201" level="5">
    <if_sid>31420</if_sid>
    <match>Maximum execution time of </match>
    <regex type="pcre2">Maximum execution time of \d+ seconds? exceeded</regex>
    <description>PHP2Shell precursor: PHP maximum execution time exceeded</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>php2shell_precursor,kill_chain_delivery,kill_chain_exploitation,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.6,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- =================================================================== -->
  <!-- Vector 2: Web Access Logs - Server 500 Crash Correlation (0245-web) -->
  <!-- =================================================================== -->

  <!-- HTTP 500 Crash on PHP Endpoints -->
  <rule id="100205" level="5">
    <if_sid>31122</if_sid>
    <url>.php</url>
    <description>Web server 500 Internal Error on PHP endpoint</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>php2shell_precursor,system_error,kill_chain_exploitation,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_SI.4,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- =================================================================== -->
  <!-- Staged Correlation & Attack Escalation                              -->
  <!-- =================================================================== -->

  <!-- Early Warning: Repeated Memory Pressure Probing (3 precursor events in 60s) -->
  <rule id="100204" level="8" frequency="3" timeframe="60">
    <if_matched_group>php2shell_precursor</if_matched_group>
    <same_source_ip />
    <description>PHP2Shell probing: Repeated memory pressure anomalies from same IP</description>
    <mitre>
      <id>T1595.002</id>
      <id>T1190</id>
    </mitre>
    <group>kill_chain_reconnaissance,kill_chain_delivery,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.6,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- Attack Correlation: High-Frequency Memory Exhaustion (5 events in 120s) -->
  <rule id="100202" level="12" frequency="5" timeframe="120">
    <if_matched_sid>100200</if_matched_sid>
    <same_source_ip />
    <description>PHP2Shell: High-frequency PHP memory exhaustion. Active RCE exploitation attempt</description>
    <mitre>
      <id>T1190</id>
      <id>T1499.003</id>
    </mitre>
    <group>php2shell_exploit,kill_chain_exploitation,pci_dss_6.5.2,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_32.2,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_SC.5,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.6,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- =================================================================== -->
  <!-- Vector 3: Host Telemetry - Linux Auditd Command Execution           -->
  <!-- =================================================================== -->

  <!-- Standalone: Command/Shell Spawned by Web Server Service User -->
  <rule id="100203" level="10">
    <if_sid>80792</if_sid>
    <field name="audit.euid">^(?:33|48|82|www-data|apache|nginx|nobody)\z</field>
    <description>PHP2Shell post-exploitation: Shell command executed by web server user</description>
    <mitre>
      <id>T1059.004</id>
    </mitre>
    <group>audit,post_exploitation,rce,kill_chain_actions_on_objectives,pci_dss_10.2.2,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_32.2,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- Chained Escalation: Command execution following PHP2Shell exploitation -->
  <rule id="100208" level="14">
    <if_sid>100203</if_sid>
    <if_matched_group>php2shell_precursor, php2shell_exploit</if_matched_group>
    <description>PHP2Shell confirmed RCE: Shell command spawned by web server user following exploitation attempts</description>
    <mitre>
      <id>T1059.004</id>
      <id>T1190</id>
    </mitre>
    <group>audit,post_exploitation,rce,kill_chain_actions_on_objectives,pci_dss_10.2.2,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_32.2,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- =================================================================== -->
  <!-- Vector 4: File Integrity Monitoring (FIM / Syscheck)                -->
  <!-- =================================================================== -->

  <!-- Standalone: New Executable Script Dropped or Modified in Web Root -->
  <rule id="100206" level="10">
    <if_sid>554, 550</if_sid>
    <field name="file" type="pcre2">^/var/www/.*?\.(?:php|phtml|phar|so)\z</field>
    <description>PHP2Shell post-exploitation: Suspicious executable script created or modified in web directory</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
    <group>syscheck,post_exploitation,webshell,kill_chain_installation,pci_dss_11.5,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_32.2,gdpr_IV_35.7.d,hipaa_164.312.c.1,nist_800_53_SI.4,nist_800_53_SI.7,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- Chained Escalation: Web shell created/modified following PHP2Shell exploitation -->
  <rule id="100207" level="14">
    <if_sid>100206</if_sid>
    <if_matched_group>php2shell_precursor, php2shell_exploit</if_matched_group>
    <description>PHP2Shell confirmed compromise: Web shell created or modified in web directory following exploitation attempts</description>
    <mitre>
      <id>T1505.003</id>
      <id>T1190</id>
    </mitre>
    <group>syscheck,post_exploitation,webshell,kill_chain_installation,pci_dss_11.5,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_32.2,gdpr_IV_35.7.d,hipaa_164.312.c.1,nist_800_53_SI.4,nist_800_53_SI.7,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

</group>

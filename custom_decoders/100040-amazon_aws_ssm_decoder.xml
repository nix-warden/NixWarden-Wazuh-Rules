<!-- Custom decoder for Amazon SSM Agent logs -->
<!-- Log format: YYYY-MM-DD HH:MM:SS LEVEL [component] message -->
<decoder name="amazon-ssm-agent">
  <prematch type="pcre2">
    ^\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}\.\d{4}\s+(?:INFO|WARN|ERROR|DEBUG|FATAL|Trace)</prematch>
</decoder>

<decoder name="amazon-ssm-agent-fields">
  <parent>amazon-ssm-agent</parent>
  <regex type="pcre2">^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})\s+(\S+)\s+(?:\[([^\]]+)\]\s+)?(.*)</regex>
  <order>ssm_timestamp, ssm_level, ssm_component, ssm_message</order>
</decoder>